{
  "plan_name": "External Process Wrapper (EPW) - 外部进程/服务封装器",
  "version": "1.0.0",
  "created_at": "2026-03-20",
  "completed_at": "2026-03-20",
  "status": "completed",
  "priority": "P1",
  "estimated_duration_days": 9,
  "actual_duration_days": 1,
  
  "executive_summary": {
    "description": "将外部进程/服务封装为 AI 可调度的 tokitai 工具，扩展自进化系统能力",
    "core_value": [
      "AI 可调用的工具从 Rust 代码扩展到任何可执行文件/HTTP 服务/脚本",
      "自进化系统发现工具缺口时，可选择封装现有工具而非仅创造 Rust 代码",
      "快速原型能力：用户可用 Python/Shell 写脚本，AI 自动封装为工具",
      "企业集成能力：轻松封装企业内部系统 HTTP API"
    ],
    "supported_types": [
      "本地可执行文件 (CLI Tools)",
      "远程 HTTP 服务 (REST APIs)",
      "系统命令 (System Commands)",
      "脚本文件 (.sh, .py, .js)"
    ]
  },

  "current_state_analysis": {
    "self_improvement_capabilities": {
      "existing_components": [
        "ToolGapDetector: 从失败任务中检测工具缺口",
        "ToolOptimizer: 分析现有工具使用效率",
        "SystemReflector: 生成系统健康报告，发现覆盖不足领域",
        "ToolCreator: 根据缺口创造 Rust 代码工具",
        "DynamicRegistry: 运行时动态注册新工具到工具矩阵"
      ],
      "workflow": "ToolGapDetector → ToolOptimizer → SystemReflector → ToolCreator → DynamicRegistry → ToolMatrix",
      "limitations": [
        "只能创造 Rust 代码工具，无法利用现有 CLI/HTTP/脚本资源",
        "外部进程调用分散在各模块，AI 无法发现和统一调度",
        "无统一的外部工具封装和注册机制"
      ]
    },
    "existing_process_invocation_patterns": {
      "pattern": "分散调用",
      "examples": [
        "src/autonomy/git_workflow.rs: 直接使用 std::process::Command 调用 git",
        "src/orchestrator/orchestrator.rs: 直接使用 Command 调用系统命令",
        "src/tools/vcs/git_ops.rs: Git 操作封装但不支持 AI 动态发现"
      ],
      "problems": [
        "无统一封装层",
        "AI 不可见：进程调用逻辑深埋代码中",
        "无法动态注册新工具",
        "无标准化输入输出 Schema"
      ]
    }
  },

  "architecture_design": {
    "layered_architecture": {
      "layer_1_ai_dispatch": {
        "name": "AI 自主调度层",
        "components": [
          "SelfImprovementLoop",
          "AutonomyAgent",
          "Orchestrator"
        ],
        "responsibility": "AI 决策和任务调度"
      },
      "layer_2_tool_matrix": {
        "name": "工具矩阵层",
        "components": [
          "ToolMatrix",
          "ToolSelector",
          "DynamicRegistry"
        ],
        "responsibility": "工具发现、选择、注册"
      },
      "layer_3_epw_wrapper": {
        "name": "EPW 封装层（新增）",
        "components": [
          "ExternalProcessWrapper (核心 trait)",
          "ProcessWrapper (本地进程)",
          "HTTPWrapper (HTTP 服务)",
          "ScriptWrapper (脚本文件)",
          "ExternalToolRegistry (外部工具注册表)"
        ],
        "responsibility": "统一封装外部进程/服务为 tokitai 工具"
      },
      "layer_4_external_execution": {
        "name": "外部执行层",
        "components": [
          "CLI Tools (git, docker, npm, etc.)",
          "HTTP APIs (OpenAI, GitHub, 自定义服务)",
          "Scripts (.sh, .py, .js)"
        ],
        "responsibility": "实际执行外部进程/服务调用"
      }
    },
    "module_structure": {
      "directory": "src/external_process/",
      "files": [
        {
          "name": "mod.rs",
          "description": "模块入口，导出公共 API"
        },
        {
          "name": "wrapper.rs",
          "description": "核心封装器 trait 定义"
        },
        {
          "name": "process_wrapper.rs",
          "description": "本地进程封装实现"
        },
        {
          "name": "http_wrapper.rs",
          "description": "HTTP 服务封装实现"
        },
        {
          "name": "script_wrapper.rs",
          "description": "脚本文件封装实现"
        },
        {
          "name": "registry.rs",
          "description": "外部工具注册表"
        },
        {
          "name": "discovery.rs",
          "description": "自动发现器（AI 自主发现外部工具）"
        },
        {
          "name": "metadata.rs",
          "description": "外部工具元数据定义"
        },
        {
          "name": "tests/",
          "description": "测试目录",
          "test_files": [
            "test_process.rs",
            "test_http.rs",
            "test_script.rs"
          ]
        }
      ]
    }
  },

  "core_data_structures": {
    "external_tool_type": {
      "file": "src/external_process/metadata.rs",
      "enum": "ExternalToolType",
      "variants": [
        {
          "name": "Process",
          "config_struct": "ProcessConfig",
          "fields": {
            "executable": "String - 可执行文件路径/名称",
            "args_template": "Vec<String> - 参数模板（支持变量替换）",
            "working_dir": "Option<PathBuf> - 工作目录",
            "timeout_ms": "u64 - 超时时间",
            "env": "HashMap<String, String> - 环境变量"
          }
        },
        {
          "name": "Http",
          "config_struct": "HttpConfig",
          "fields": {
            "base_url": "String - 基础 URL",
            "method": "String - HTTP 方法",
            "path_template": "String - 路径模板",
            "headers": "HashMap<String, String> - 请求头",
            "auth": "Option<AuthConfig> - 认证方式",
            "timeout_ms": "u64 - 超时时间"
          }
        },
        {
          "name": "Script",
          "config_struct": "ScriptConfig",
          "fields": {
            "script_path": "PathBuf - 脚本路径",
            "interpreter": "Option<String> - 解释器（bash/python/node 等）",
            "args_template": "Vec<String> - 参数模板",
            "working_dir": "Option<PathBuf> - 工作目录"
          }
        }
      ]
    },
    "external_tool_metadata": {
      "struct": "ExternalToolMetadata",
      "fields": {
        "name": "String - 工具名称",
        "description": "String - 工具描述",
        "tool_type": "ExternalToolType - 工具类型",
        "input_schema": "serde_json::Value - 输入参数 Schema（JSON Schema）",
        "output_schema": "Option<serde_json::Value> - 输出 Schema",
        "domain": "String - 所属领域",
        "tags": "Vec<String> - 标签",
        "risk_level": "RiskLevel - 风险等级",
        "created_by": "String - 创建者（AI Agent 或用户）",
        "created_at": "String - 创建时间",
        "enabled": "bool - 是否启用"
      }
    },
    "tool_execution_result": {
      "struct": "ToolExecutionResult",
      "fields": {
        "success": "bool - 是否成功",
        "output": "serde_json::Value - 输出结果",
        "error": "Option<String> - 错误信息",
        "execution_time_ms": "u64 - 执行时间",
        "stdout": "Option<String> - 标准输出",
        "stderr": "Option<String> - 标准错误"
      }
    }
  },

  "core_traits": {
    "external_tool_trait": {
      "file": "src/external_process/wrapper.rs",
      "trait_name": "ExternalTool",
      "methods": [
        {
          "name": "metadata",
          "signature": "fn metadata(&self) -> &ExternalToolMetadata",
          "description": "获取工具元数据"
        },
        {
          "name": "execute",
          "signature": "async fn execute(&self, input: serde_json::Value) -> Result<ToolExecutionResult>",
          "description": "执行工具"
        },
        {
          "name": "validate_input",
          "signature": "fn validate_input(&self, input: &serde_json::Value) -> Result<()>",
          "description": "验证输入"
        },
        {
          "name": "to_tool_definition",
          "signature": "fn to_tool_definition(&self) -> ToolDefinition",
          "description": "获取工具定义（用于注册到 ToolMatrix）"
        }
      ]
    }
  },

  "auto_discovery_system": {
    "discovery_struct": "ExternalToolDiscovery",
    "file": "src/external_process/discovery.rs",
    "fields": {
      "search_paths": "Vec<PathBuf> - 搜索路径",
      "discovered_tools": "Vec<ExternalToolMetadata> - 已发现的工具",
      "llm_client": "Arc<DefaultLLMClient> - LLM 客户端（用于自动生成工具描述）"
    },
    "methods": [
      {
        "name": "new",
        "signature": "pub fn new(llm_client: Arc<DefaultLLMClient>) -> Self",
        "description": "创建新的发现器"
      },
      {
        "name": "scan_executables",
        "signature": "pub async fn scan_executables(&mut self) -> Result<Vec<ExternalToolMetadata>>",
        "description": "扫描 PATH 中的可执行文件"
      },
      {
        "name": "scan_scripts",
        "signature": "pub async fn scan_scripts(&mut self, dir: &Path) -> Result<Vec<ExternalToolMetadata>>",
        "description": "扫描指定目录的脚本文件"
      },
      {
        "name": "from_openapi",
        "signature": "pub async fn from_openapi(&mut self, openapi_url: &str) -> Result<Vec<ExternalToolMetadata>>",
        "description": "从 OpenAPI/Swagger 规范发现 HTTP 服务"
      },
      {
        "name": "ai_enrich_metadata",
        "signature": "pub async fn ai_enrich_metadata(&self, tool: &mut ExternalToolMetadata) -> Result<()>",
        "description": "AI 辅助生成工具描述和参数"
      },
      {
        "name": "register_to_matrix",
        "signature": "pub async fn register_to_matrix(&self, tools: &[ExternalToolMetadata]) -> Result<()>",
        "description": "批量注册到工具矩阵"
      }
    ]
  },

  "self_improvement_integration": {
    "file": "src/autonomy/self_improvement_loop.rs (扩展)",
    "enhanced_workflow": {
      "step_1": {
        "name": "检测工具缺口",
        "component": "ToolGapDetector",
        "action": "analyze_failed_tasks()"
      },
      "step_2": {
        "name": "优化现有工具",
        "component": "ToolOptimizer",
        "action": "analyze_usage_patterns()"
      },
      "step_3": {
        "name": "系统反思",
        "component": "SystemReflector",
        "action": "generate_health_report()"
      },
      "step_4a": {
        "name": "创造 Rust 代码工具（现有）",
        "component": "ToolCreator",
        "action": "create_tool(gap_request)",
        "condition": "gap.priority >= threshold"
      },
      "step_4b": {
        "name": "封装外部工具（新增）",
        "component": "ExternalToolDiscovery + AI Agent",
        "actions": [
          "AI 分析缺口：是否存在现成 CLI/HTTP/脚本可封装？",
          "扫描系统可执行文件",
          "AI 生成工具元数据（描述、参数 Schema）",
          "注册外部工具到工具矩阵"
        ]
      },
      "step_5": {
        "name": "生成报告",
        "output": "EvolutionCycleReport"
      }
    },
    "ai_decision_logic": {
      "decision_tree": [
        "IF gap.requires_high_performance AND gap.is_complex → 创造 Rust 工具",
        "IF existing_cli_matches_gap → 封装 CLI 工具",
        "IF http_api_available → 封装 HTTP 服务",
        "IF rapid_prototyping_needed → 封装脚本文件",
        "ELSE → 创造 Rust 工具"
      ]
    }
  },

  "usage_examples": {
    "example_1_process_wrapper": {
      "scenario": "AI 自主封装 git commit 命令",
      "code_file": "examples/epw_git_example.rs",
      "steps": [
        "1. AI 扫描发现 git 可执行文件",
        "2. AI 识别 git 并生成 ProcessConfig",
        "3. 创建 ExternalToolMetadata（含输入 Schema）",
        "4. 注册到工具矩阵",
        "5. AI 现在可调用 git_commit 工具"
      ],
      "tool_config": {
        "name": "git_commit",
        "description": "提交代码到 Git 仓库",
        "tool_type": "Process",
        "config": {
          "executable": "git",
          "args_template": ["commit", "-m", "{{message}}"],
          "timeout_ms": 30000
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "message": {"type": "string", "description": "提交信息"}
          },
          "required": ["message"]
        }
      }
    },
    "example_2_http_wrapper": {
      "scenario": "AI 封装 GitHub API 创建 Issue",
      "code_file": "examples/epw_github_example.rs",
      "tool_config": {
        "name": "github_create_issue",
        "description": "在 GitHub 仓库创建 Issue",
        "tool_type": "Http",
        "config": {
          "base_url": "https://api.github.com",
          "method": "POST",
          "path_template": "/repos/{{owner}}/{{repo}}/issues",
          "auth": "BearerToken(GITHUB_TOKEN)"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "owner": {"type": "string"},
            "repo": {"type": "string"},
            "title": {"type": "string"},
            "body": {"type": "string"}
          },
          "required": ["owner", "repo", "title"]
        }
      }
    },
    "example_3_script_wrapper": {
      "scenario": "AI 封装 Python 数据分析脚本",
      "code_file": "examples/epw_python_script_example.rs",
      "tool_config": {
        "name": "analyze_data",
        "description": "使用 Python 脚本分析数据文件",
        "tool_type": "Script",
        "config": {
          "script_path": "scripts/analyze.py",
          "interpreter": "python3",
          "args_template": ["--input", "{{input_file}}"],
          "working_dir": "/workspace"
        },
        "input_schema": {
          "type": "object",
          "properties": {
            "input_file": {"type": "string", "description": "输入文件路径"}
          },
          "required": ["input_file"]
        }
      }
    }
  },

