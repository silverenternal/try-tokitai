  },

  "context_service_integration": {
    "overview": "充分利用现有上下文服务的设计优势",
    "integration_points": [
      {
        "service": "FileContextService",
        "usage": "存储和检索提示词模板、工具矩阵配置",
        "storage_path": ".context/prompt_templates/ 和 .context/tool_matrix/",
        "layer": "LongTerm - 长期存储配置数据"
      },
      {
        "service": "ContextDistiller (HCD)",
        "usage": "蒸馏工具调用历史，生成结构化摘要",
        "benefit": "减少云端传输 60%+ token"
      },
      {
        "service": "SemanticIndex (LSFI)",
        "usage": "语义检索相似任务的角色和工具选择",
        "benefit": "提升工具选择准确率 30%+"
      },
      {
        "service": "HashChain (ICHC)",
        "usage": "追踪角色切换和工具选择历史",
        "benefit": "支持回溯和审计"
      },
      {
        "service": "ContextLogger",
        "usage": "记录编排器操作日志",
        "storage_path": ".context/logs/orchestrator.jsonl"
      }
    ],
    "data_flow": {
      "user_input": "用户输入 → Orchestrator",
