{
  "meta": {
    "document_title": "提示词工程与工具矩阵服务开发规划",
    "version": "1.0.0",
    "date": "2026-03-14",
    "author": "P11 Level Engineering Team",
    "target_system": "Tokitai AI Assistant - Prompt Engineering & Tool Matrix Services",
    "design_philosophy": {
      "principle": "轻量化、模块化、零数据库依赖",
      "core_values": [
        "纯文件存储 - 所有配置和状态使用 JSON/JSONL 文件",
        "零外部服务 - 不依赖额外的中间件或云服务",
        "最小依赖 - 仅使用现有 Rust 生态依赖",
        "内存高效 - 常驻内存 <300MB",
        "启动快速 - 冷启动 <1s"
      ],
      "architecture_style": "Unix 哲学 - 每个服务做好一件事，通过文件组合"
    }
  },

  "executive_summary": {
    "problem_statement": {
      "current_state": "当前 AI 助手在每次请求时发送全部工具定义（50+ 工具），导致：",
      "problems": [
        "上下文 token 消耗大 - 工具定义占用 30-40% 的 token 预算",
        "角色定位模糊 - AI 不清楚当前应该使用哪些工具子集",
        "工具选择效率低 - AI 需要在大量工具中搜索合适的工具",
        "长对话质量下降 - token 限制导致早期上下文被裁剪"
      ],
      "root_cause": "缺乏工具矩阵和角色切换机制，所有请求使用相同的工具集和提示词"
    },

    "solution_overview": {
      "approach": "实现提示词工程服务和工具矩阵服务，通过角色切换和动态工具选择减少上下文开销",
      "key_components": [
        "Prompt Engineering Service - 管理多角色提示词模板",
        "Tool Matrix Service - 按角色过滤可用工具子集",
        "Role Switching Mechanism - 根据任务类型自动切换角色",
        "Context Optimization - 利用本地上下文服务减少云端传输"
      ],
      "expected_benefits": [
        "上下文 token 减少 50-70%",
        "工具选择准确率提升 40%",
        "长对话质量提升 60%",
        "AI 响应速度提升 30%"
      ]
    },

    "leverage_existing_assets": {
      "context_service": {
        "feature": "分层上下文存储（Transient/ShortTerm/LongTerm）",
        "usage": "存储角色提示词模板和工具矩阵配置"
      },
      "context_distillation": {
        "feature": "分层上下文蒸馏（HCD）",
        "usage": "蒸馏工具调用历史，仅传输结构化摘要到云端"
      },
      "semantic_index": {
        "feature": "本地语义指纹索引（LSFI）",
        "usage": "语义检索相似任务的角色和工具选择"
      },
      "hash_chain": {
        "feature": "增量式哈希链（ICHC）",
        "usage": "追踪角色切换和工具选择历史"
      },
      "tokitai_integration": {
        "feature": "tokitai::tool 宏和 ToolProvider trait",
        "usage": "工具定义和调用，保持现有接口不变"
      }
    }
  },

  "architecture_design": {
    "module_structure": {
      "src/prompt_engineering/": {
        "description": "提示词工程服务",
        "files": [
          "mod.rs - 模块导出",
          "template.rs - 提示词模板结构定义",
          "manager.rs - 提示词模板管理器",
          "role_prompt.rs - 角色提示词（Planner/Executor/Reviewer/Researcher）",
          "task_prompt.rs - 任务专用提示词（分解/审查/Git/搜索）",
          "renderer.rs - 提示词渲染引擎"
        ]
      },
      "src/tool_matrix/": {
        "description": "工具矩阵服务",
        "files": [
          "mod.rs - 模块导出",
          "matrix.rs - 工具矩阵结构定义",
          "filter.rs - 工具过滤器",
          "role_tool_mapping.rs - 角色 - 工具映射配置",
          "selector.rs - 动态工具选择器",
          "registry.rs - 工具注册表"
        ]
      },
      "src/orchestrator/": {
        "description": "编排器 - 协调提示词工程和工具矩阵",
        "files": [
          "mod.rs - 模块导出",
          "role_switcher.rs - 角色切换器",
          "context_optimizer.rs - 上下文优化器",
          "workflow.rs - 工作流程引擎"
        ]
      }
    },

    "data_storage_structure": {
      ".context/prompt_templates/": {
        "description": "提示词模板存储",
        "files": [
          "roles/planner.json - 规划师角色提示词",
          "roles/executor.json - 执行师角色提示词",
          "roles/reviewer.json - 审查师角色提示词",
          "roles/researcher.json - 研究员角色提示词",
          "tasks/task_decomposition.json - 任务分解提示词",
          "tasks/code_review.json - 代码审查提示词",
          "tasks/git_commit.json - Git 提交提示词",
          "tasks/web_search.json - 网络搜索提示词"
        ]
      },
      ".context/tool_matrix/": {
        "description": "工具矩阵配置存储",
        "files": [
          "matrix.json - 完整工具矩阵",
          "role_mappings.json - 角色 - 工具映射",
          "usage_stats.jsonl - 工具使用统计日志"
        ]
      },
      ".context/orchestrator/": {
        "description": "编排器状态存储",
        "files": [
          "current_role.json - 当前角色状态",
          "workflow_history.jsonl - 工作流程历史",
          "optimization_stats.json - 优化统计"
        ]
      }
    },

    "service_interfaces": {
      "PromptEngineeringService": {
        "methods": [
          "fn load_template(&self, role: &str) -> Result<PromptTemplate>",
          "fn render(&self, template: &PromptTemplate, variables: &Value) -> Result<String>",
          "fn get_system_prompt(&self, role: &str) -> Result<String>",
          "fn register_template(&mut self, role: &str, template: PromptTemplate) -> Result<()>",
          "fn get_all_roles(&self) -> Vec<String>"
        ]
      },
      "ToolMatrixService": {
        "methods": [
          "fn get_tools_for_role(&self, role: &str) -> Result<Vec<ToolDefinition>>",
          "fn filter_tools(&self, tools: &[ToolDefinition], criteria: &FilterCriteria) -> Result<Vec<ToolDefinition>>",
          "fn select_tools_dynamic(&self, query: &str, max_tools: usize) -> Result<Vec<ToolDefinition>>",
          "fn register_tool(&mut self, tool: ToolDefinition, roles: Vec<String>) -> Result<()>",
          "fn get_usage_stats(&self, tool_name: &str) -> Result<ToolUsageStats>"
        ]
      },
      "OrchestratorService": {
        "methods": [
          "fn switch_role(&mut self, new_role: &str) -> Result<RoleSwitchResult>",
          "fn optimize_context(&mut self, session: &str) -> Result<OptimizationResult>",
          "fn execute_workflow(&mut self, workflow: &Workflow) -> Result<WorkflowResult>",
          "fn get_current_state(&self) -> &OrchestratorState"
        ]
      }
    }
  },

  "detailed_implementation": {
    "phase_1_prompt_engineering": {
      "name": "提示词工程服务实现",
      "duration": "5-7 天",
      "priority": "P0",
      "tasks": [
        {
          "id": "PE-001",
          "title": "提示词模板结构设计",
          "description": "定义 PromptTemplate 结构，支持变量替换和条件渲染",
          "deliverables": ["src/prompt_engineering/template.rs"],
          "code_example": {
            "struct_name": "PromptTemplate",
            "fields": {
              "id": "String - 模板唯一标识",
              "name": "String - 模板名称",
              "role": "String - 适用角色",
              "system_prompt": "String - 系统提示词",
              "variables": "Vec<Variable> - 变量定义",
              "examples": "Vec<Example> - 示例对话",
              "constraints": "Vec<String> - 约束条件",
              "version": "String - 版本号"
            }
          }
        },
        {
          "id": "PE-002",
          "title": "提示词模板管理器",
          "description": "实现模板加载、注册、渲染功能",
          "deliverables": ["src/prompt_engineering/manager.rs"],
          "features": [
            "从 .context/prompt_templates/ 加载 JSON 模板",
            "支持热加载和版本控制",
            "变量替换引擎（支持嵌套变量）",
            "模板缓存（减少文件 IO）"
          ]
        },
        {
          "id": "PE-003",
          "title": "角色提示词定义",
          "description": "为 4 个核心角色定义专业提示词",
          "roles": [
            {
              "role": "Planner",
              "responsibility": "任务分解和规划",
              "tools": ["web_search", "read_file", "grep", "list_dir"],
              "prompt_focus": "分析目标、识别依赖、制定步骤"
            },
            {
              "role": "Executor",
              "responsibility": "按计划执行任务",
              "tools": ["write_file", "run_command", "git_ops", "file_ops"],
              "prompt_focus": "精确执行、错误处理、进度报告"
            },
            {
              "role": "Reviewer",
              "responsibility": "代码审查和质量把关",
              "tools": ["read_file", "code_analysis", "grep"],
              "prompt_focus": "多维度审查、问题定位、改进建议"
            },
            {
              "role": "Researcher",
              "responsibility": "信息收集和调研",
              "tools": ["web_search", "download", "http_client"],
              "prompt_focus": "信息筛选、来源验证、结构化总结"
            }
          ],
          "deliverables": [".context/prompt_templates/roles/*.json"]
        },
        {
          "id": "PE-004",
          "title": "任务专用提示词",
          "description": "为常见任务定义专用提示词",
          "tasks": [
            "task_decomposition - 任务分解",
            "code_review - 代码审查",
            "git_commit - Git 提交消息生成",
            "web_search - 网络搜索查询优化"
          ],
          "deliverables": [".context/prompt_templates/tasks/*.json"]
        },
        {
          "id": "PE-005",
          "title": "提示词渲染引擎",
          "description": "实现模板渲染和变量替换",
          "features": [
            "Mustache 风格变量替换（{{variable}}）",
            "条件渲染（{{#if condition}}...{{/if}}）",
            "循环渲染（{{#each items}}...{{/each}}）",
            "内置函数（uppercase, lowercase, truncate）"
          ],
          "deliverables": ["src/prompt_engineering/renderer.rs"]
        }
      ]
    },

    "phase_2_tool_matrix": {
      "name": "工具矩阵服务实现",
      "duration": "5-7 天",
      "priority": "P0",
      "tasks": [
        {
          "id": "TM-001",
          "title": "工具矩阵结构设计",
          "description": "定义工具矩阵和角色 - 工具映射",
          "deliverables": ["src/tool_matrix/matrix.rs"],
          "code_example": {
            "struct_name": "ToolMatrix",
            "fields": {
              "tools": "HashMap<String, ToolDefinition> - 所有工具定义",
              "role_mappings": "HashMap<String, Vec<String>> - 角色到工具的映射",
              "tool_tags": "HashMap<String, Vec<String>> - 工具标签（用于过滤）",
              "usage_stats": "HashMap<String, UsageStats> - 使用统计"
            }
          }
        },
        {
          "id": "TM-002",
          "title": "工具注册表",
          "description": "实现工具注册和发现机制",
          "features": [
            "自动发现 tokitai::tool 宏标记的工具",
            "手动注册外部工具",
            "工具元数据（名称、描述、参数、标签）",
            "工具依赖关系图"
          ],
          "deliverables": ["src/tool_matrix/registry.rs"]
        },
        {
          "id": "TM-003",
          "title": "工具过滤器",
          "description": "实现多维度工具过滤",
          "filter_criteria": [
            "by_role - 按角色过滤",
            "by_tag - 按标签过滤（如：read_only, write, network）",
            "by_complexity - 按复杂度过滤（简单/中等/复杂）",
            "by_risk_level - 按风险等级过滤（安全/中等/危险）"
          ],
          "deliverables": ["src/tool_matrix/filter.rs"]
        },
        {
          "id": "TM-004",
          "title": "动态工具选择器",
          "description": "根据查询语义自动选择工具子集",
          "algorithm": {
            "step_1": "使用语义索引分析查询意图",
            "step_2": "从工具矩阵中筛选相关工具",
            "step_3": "根据历史使用统计排序",
            "step_4": "返回 top N 个工具"
          },
          "integration": {
            "context_service": "使用 semantic_index 进行意图分析",
            "hash_chain": "记录工具选择历史到哈希链"
          },
          "deliverables": ["src/tool_matrix/selector.rs"]
        },
        {
          "id": "TM-005",
          "title": "角色 - 工具映射配置",
          "description": "定义每个角色可使用的工具子集",
          "role_mappings": {
            "Planner": {
              "tools": ["web_search", "read_file", "grep", "list_dir", "code_analysis"],
              "max_tools": 5,
              "priority": "信息收集和分析工具"
            },
            "Executor": {
              "tools": ["write_file", "run_command", "git_ops", "file_ops", "process_tools"],
              "max_tools": 5,
              "priority": "执行和修改工具"
            },
            "Reviewer": {
              "tools": ["read_file", "code_analysis", "grep", "file_search"],
              "max_tools": 4,
              "priority": "审查和分析工具"
            },
            "Researcher": {
              "tools": ["web_search", "download", "http_client", "network_tools"],
              "max_tools": 4,
              "priority": "网络和下载工具"
            }
          },
          "deliverables": [".context/tool_matrix/role_mappings.json"]
        }
      ]
    },

    "phase_3_orchestrator": {
      "name": "编排器实现",
      "duration": "7-10 天",
      "priority": "P0",
      "tasks": [
        {
          "id": "OR-001",
          "title": "角色切换器",
          "description": "实现基于任务类型的自动角色切换",
          "features": [
            "意图识别 - 分析用户输入确定合适角色",
            "状态保持 - 保存和恢复角色状态",
            "平滑切换 - 角色切换时保持上下文连续性",
            "手动覆盖 - 允许用户显式指定角色"
          ],
          "decision_matrix": {
            "规划类任务": "Planner",
            "执行类任务": "Executor",
            "审查类任务": "Reviewer",
            "调研类任务": "Researcher",
            "通用任务": "自动识别或保持当前角色"
          },
          "deliverables": ["src/orchestrator/role_switcher.rs"]
        },
        {
          "id": "OR-002",
          "title": "上下文优化器",
          "description": "利用本地上下文服务减少云端传输",
          "optimization_strategies": [
            {
              "strategy": "工具定义本地缓存",
              "implementation": "工具定义存储在本地，云端仅发送工具名称",
              "token_saving": "减少 30-40% token"
            },
            {
              "strategy": "蒸馏摘要传输",
              "implementation": "使用 HCD 生成交互摘要，仅传输结构化内容",
              "token_saving": "减少 50-60% token"
            },
            {
              "strategy": "语义检索增强",
              "implementation": "本地检索相关上下文，按需添加到请求",
              "token_saving": "减少 20-30% token"
            },
            {
              "strategy": "哈希链增量传输",
              "implementation": "仅传输最新 N 个哈希链节点",
              "token_saving": "减少 40-50% token"
            }
          ],
          "integration": {
            "file_context_service": "使用 prepare_cloud_payload 获取最小载荷",
            "distiller": "使用 get_distilled_summary 获取结构化摘要",
            "semantic_index": "使用 search_context 检索相关上下文"
          },
          "deliverables": ["src/orchestrator/context_optimizer.rs"]
        },
        {
          "id": "OR-003",
          "title": "工作流程引擎",
          "description": "定义和执行多步骤工作流程",
          "workflow_types": [
            {
              "name": "代码开发流程",
              "steps": ["Planner 分析需求", "Executor 实现代码", "Reviewer 审查代码", "Executor 提交 Git"]
            },
            {
              "name": "问题排查流程",
              "steps": ["Researcher 搜索类似问题", "Planner 制定排查计划", "Executor 执行诊断", "Reviewer 验证修复"]
            },
            {
              "name": "功能改进流程",
              "steps": ["Planner 分析现状", "Researcher 调研最佳实践", "Executor 实施改进", "Reviewer 审查质量"]
            }
          ],
          "deliverables": ["src/orchestrator/workflow.rs"]
        },
        {
          "id": "OR-004",
          "title": "与 main.rs 集成",
          "description": "将编排器集成到主程序",
          "changes": [
            "修改 AiAssistant 结构体，添加 orchestrator 字段",
            "修改 chat_and_handle_tools 方法，添加角色切换逻辑",
            "修改 get_tool_definitions 方法，使用工具矩阵过滤",
            "添加系统提示词，使用提示词工程服务"
          ],
          "deliverables": ["src/main.rs (modified)", "src/orchestrator/mod.rs"]
        },
        {
          "id": "OR-005",
          "title": "与 TUI 集成",
          "description": "将编排器集成到 TUI 界面",
          "ui_components": [
            "角色指示器 - 显示当前角色",
            "工具面板 - 显示当前可用工具",
            "优化统计 - 显示 token 节省情况",
            "工作流程进度 - 显示多步骤流程进度"
          ],
          "deliverables": ["src/tui/orchestrator_panel.rs", "src/tui/assistant.rs (modified)"]
        }
      ]
    },

