    "example_prompt_template": {
      "id": "planner_v1",
      "name": "规划师角色提示词",
      "role": "Planner",
      "system_prompt": "你是一位资深技术架构师，擅长制定高效的技术实施方案。\n\n你的职责：\n1. 分析任务目标和约束条件\n2. 调研相关技术和最佳实践\n3. 制定分步实施计划\n4. 预估风险和回滚方案\n\n可用工具：{{tools}}\n\n请按照以下格式输出计划：\n1. 目标分析\n2. 实施步骤\n3. 风险评估",
      "variables": [
        {
          "name": "tools",
          "type": "string",
          "description": "可用工具列表"
        }
      ],
      "examples": [
        {
          "user": "改进项目的错误处理系统",
          "assistant": "## 目标分析\n当前项目使用 String 作为错误类型，缺乏结构化...\n\n## 实施步骤\n1. 调研 Rust 错误处理最佳实践\n2. 分析当前代码的错误处理方式\n3. 设计新的错误类型定义\n4. 实现错误类型和转换\n5. 更新所有错误处理点\n\n## 风险评估\n- 风险：可能破坏现有 API 兼容性\n- 回滚：保留旧接口，逐步迁移"
        }
      ],
      "version": "1.0.0"
    },
    "example_tool_matrix_config": {
      "roles": {
        "Planner": {
          "tools": ["web_search", "read_file", "grep", "list_dir", "code_analysis"],
          "max_tokens_for_definitions": 500,
          "priority": "information_gathering"
        },
        "Executor": {
          "tools": ["write_file", "run_command", "git_ops", "file_ops"],
          "max_tokens_for_definitions": 400,
          "priority": "execution"
        }
      }
    },
