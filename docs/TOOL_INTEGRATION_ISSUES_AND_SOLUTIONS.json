  "critical_issues": [
    {
      "id": "CRIT-001",
      "severity": "严重",
      "title": "Data 模块 3 个工具类未注册到工具矩阵",
      "affected_tools": [
        "JsonQueryTools (query_json, extract_keys)",
        "JsonMergeTools (merge_json, merge_json_with_defaults)",
        "DataConversionTools (json_to_csv, batch_json_to_csv)"
      ],
      "impact": "AI 无法发现和调用这 6 个数据工具，功能浪费",
      "root_cause": "main.rs 中只注册了 JsonFormatTools（以 JsonTools 别名），遗漏了其他 3 个工具类",
      "location": "src/main.rs:238",
      "evidence": {
        "import_exists": true,
        "import_line": "use tools::data::{JsonQueryTools, JsonMergeTools, DataConversionTools};",
        "registration_missing": true,
        "only_registered": "JsonTools (JsonFormatTools 的别名)"
      },
      "solution": {
        "action": "在 main.rs 中添加 3 个工具类的注册",
        "code_change": {
          "location": "src/main.rs:238 之后",
          "add_lines": [
            "let _ = tool_registry.register_from_provider_sync::<JsonQueryTools>(Some(\"data\"), ToolSource::Builtin);",
            "let _ = tool_registry.register_from_provider_sync::<JsonMergeTools>(Some(\"data\"), ToolSource::Builtin);",
            "let _ = tool_registry.register_from_provider_sync::<DataConversionTools>(Some(\"data\"), ToolSource::Builtin);"
          ]
        },
        "effort": "5 分钟",
        "risk": "无风险 - 仅添加注册调用"
      }
    },
    {
      "id": "CRIT-002",
      "severity": "严重",
      "title": "SystemMonitor 未注册到工具矩阵",
      "affected_tools": [
        "SystemMonitor (get_system_resources, get_system_info, get_cpu_info, get_memory_info, get_disk_info, get_uptime)"
      ],
      "impact": "AI 无法获取系统资源使用情况，缺少重要的系统监控能力",
      "root_cause": "main.rs 中只注册了 SystemCommands/ProcessManager/CodeAnalyzer，遗漏了 SystemMonitor",
      "location": "src/main.rs:232-234",
      "evidence": {
        "tool_macro_exists": true,
        "tool_count": 6,
        "registration_missing": true
      },
      "solution": {
        "action": "在 main.rs 中添加 SystemMonitor 的注册",
        "code_change": {
          "location": "src/main.rs:234 之后",
          "add_lines": [
            "let _ = tool_registry.register_from_provider_sync::<SystemMonitor>(Some(\"system\"), ToolSource::Builtin);"
          ]
        },
        "effort": "2 分钟",
        "risk": "无风险 - 仅添加注册调用"
      }
    }
  ],

  "major_issues": [
    {
      "id": "MAJ-001",
      "severity": "重要",
      "title": "FileCache 未注册到工具矩阵",
      "affected_tools": [
        "FileCache (get, set, delete, clear)"
      ],
      "impact": "AI 无法使用文件缓存功能",
      "root_cause": "FileCache 设计为辅助工具类，未作为独立 ToolProvider 注册",
      "location": "src/tools/io/file_cache.rs",
      "recommendation": {
        "action": "评估 FileCache 是否需要作为独立工具暴露给 AI",
        "options": [
          {
            "option": "A - 保持现状",
            "rationale": "FileCache 作为内部缓存机制，不需要 AI 直接调用"
          },
          {
            "option": "B - 注册为工具",
            "rationale": "如果 AI 需要管理缓存，则注册到 file_ops 工具箱"
          }
        ]
      }
    },
    {
      "id": "MAJ-002",
      "severity": "重要",
      "title": "RequestMonitor 未使用#[tool] 宏",
      "affected_tools": [],
      "impact": "RequestMonitor 仅为辅助监控类，无法被 AI 调用",
      "root_cause": "RequestMonitor 设计为 HttpClientTools 的内部组件，不是独立 ToolProvider",
      "location": "src/tools/network/request_monitor.rs",
      "recommendation": {
        "action": "保持现状 - 这是合理的设计决策",
        "rationale": "RequestMonitor 用于监控 HTTP 请求统计，不应直接暴露给 AI"
      }
    },
    {
      "id": "MAJ-003",
      "severity": "重要",
      "title": "DataService 服务生命周期未被使用",
      "affected_tools": ["所有 data 模块工具"],
      "impact": "DataService 实现了 ServiceLifecycle 但未被集成到服务管理体系",
