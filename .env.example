# AI API 配置
# 复制此文件为 .env 并填入你的真实 API key

# ============================================================================
# 单供应商模式（默认）
# ============================================================================
# 直接配置当前使用的供应商

# API 端点 URL
AI_API_URL=https://ollama.com/v1/chat/completions

# API Key (从 ollama.com 获取)
AI_API_KEY=your_api_key_here

# 默认模型
AI_MODEL=qwen3.5:397b

# ============================================================================
# 多供应商模式（可选）
# ============================================================================
# 如果配置了 PROVIDERS，则可以同时使用多个供应商并通过 /switch 命令切换
#
# 示例：配置 Ollama 和 OpenAI 两个供应商
#
# PROVIDERS=ollama,openai
#
# # Ollama 配置
# PROVIDER_OLLAMA_API_URL=https://ollama.com/v1/chat/completions
# PROVIDER_OLLAMA_API_KEY=ollama_key_here
# PROVIDER_OLLAMA_MODEL=qwen3.5:397b
#
# # OpenAI 配置
# PROVIDER_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# PROVIDER_OPENAI_API_KEY=sk-xxx
# PROVIDER_OPENAI_MODEL=gpt-4o
#
# 使用时：
#   • 启动后输入 /switch 切换到下一个供应商
#   • 输入 /providers 查看所有可用供应商
# ============================================================================

# SearXNG 搜索引擎（可选，提高新闻/图片搜索成功率）
# 公共实例：https://searx.be, https://search.ononoki.org
# SEARXNG_URL=https://searx.be
