# try-tokitai 环境变量配置
# 复制此文件为 .env 并填入实际的 API Key

# ============================================================================
# 单提供商模式（默认）
# ============================================================================

# Ollama（推荐，有免费额度）
AI_API_URL=https://ollama.com/v1/chat/completions
AI_API_KEY=ollama-your-api-key-here
AI_MODEL=qwen3.5:397b

# OpenAI
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-your-api-key-here
# AI_MODEL=gpt-4o

# Anthropic
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_API_KEY=sk-ant-your-api-key-here
# AI_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
# AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
# AI_API_KEY=your-api-key-here
# AI_MODEL=gemini-2.0-flash

# 智谱 AI
# AI_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# AI_API_KEY=your-api-key-here
# AI_MODEL=glm-4

# 月之暗面
# AI_API_URL=https://api.moonshot.cn/v1/chat/completions
# AI_API_KEY=sk-your-api-key-here
# AI_MODEL=moonshot-v1-8k

# 本地 Ollama
# AI_API_URL=http://localhost:11434/v1/chat/completions
# AI_API_KEY=ollama
# AI_MODEL=qwen3.5:397b

# ============================================================================
# 多提供商模式（可选）
# ============================================================================
# 配置多提供商后可使用 /model 命令动态切换
# 详见 docs/QUICKSTART.md

# ============================================================================
# 其他配置（可选）
# ============================================================================

# SearXNG 搜索引擎（可选，提升搜索成功率）
# SEARXNG_URL=https://searx.be

# 日志级别（可选）
# RUST_LOG=info
