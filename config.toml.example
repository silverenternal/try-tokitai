# AI Assistant 配置文件

[ai]
# 模型名称
model = "qwen3.5:397b"
# 温度（0.0-1.0，越高越有创造性）
temperature = 0.7
# 最大 token 数
max_tokens = 4096

[tools]
# 启用的工具集（留空表示全部启用）
# enabled = ["file_ops", "system", "code_analysis", "web_search", "download", "git_ops"]

[search]
# SearXNG 服务地址（推荐配置，提高搜索可靠性）
# 系统会自动尝试多个公共 SearXNG 实例（按优先级）：
#   1. SEARXNG_URL 环境变量（如果设置）
#   2. https://searx.be
#   3. https://search.ononoki.org
#   4. https://s.x.com
#   5. https://searx.org
# 所有 SearXNG 不可用时，自动回退到 DuckDuckGo
# searxng_url = "https://searx.be"
# 搜索引擎列表
engines = ["google", "bing", "duckduckgo"]
# 搜索缓存容量（条数）
cache_capacity = 100
# 缓存过期时间（秒）
cache_ttl_secs = 3600

[download]
# 默认下载目录（可选，留空则使用系统下载目录）
# default_dir = "/tmp/downloads"
