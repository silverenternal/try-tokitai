  "root_cause_analysis": {
    "issue_1_sparse_index_linear_scan": {
      "file": "src/sparse_index.rs:55",
      "problem": "find() 使用 O(n) 线性扫描",
      "code": "self.entries.iter().find(|e| e.key == key)",
      "impact": "每次查找最多 n 次比较，n 为 segment 中 key 数量",
      "worst_case": "100K keys → 100,000 次比较",
      "rocksdb_comparison": "RocksDB 使用 Block Hash Index O(1) 或 Binary Search O(log n)",
      "severity": "P0"
    },
    "issue_2_multiple_lock_acquisitions": {
      "file": "src/lib.rs:917",
      "problem": "get() 方法多次获取读锁",
      "details": [
        "segments.read() - 获取 segments 读锁",
        "index_manager.read() - 获取 index_manager 读锁",
        "bloom_filter_cache.get() - 可能回源到磁盘",
        "index_manager.get_index() - 在循环中重复调用"
      ],
      "impact": "多次锁获取增加延迟，尤其在并发场景",
      "severity": "P1"
    },
    "issue_3_block_cache_inefficiency": {
      "file": "src/lib.rs:929",
      "problem": "Block Cache 命中率极低，且使用 BTreeMap O(log n) 查找",
      "evidence": "热缓存测试仍需要 154ms，说明 cache 未生效",
      "possible_causes": [
        "get_by_key() 使用 O(log n) 查找",
        "Cache 容量不足导致频繁淘汰",
        "预热后 cache 未正确填充",
        "cache key 设计不合理"
      ],
      "severity": "P0"
    },
    "issue_4_range_query_no_batching": {
      "file": "benches/file_kv_inno002_bench.rs",
      "problem": "Range Query 逐个 key 读取，无批量 I/O",
      "evidence": "10K keys: 85ms, 100K keys: 1000ms",
      "complexity": "O(n) 次独立 I/O 操作",
      "severity": "P0"
    },
    "issue_5_get_method_complexity": {
      "file": "src/lib.rs:917-990",
      "problem": "get() 方法调用链过长，多层检查",
      "steps": [
        "MemTable 查找",
        "Block Cache 查找",
        "遍历 segments (newest to oldest)",
        "Bloom Filter 检查 (可能回源)",
        "Zone Map 检查",
        "SparseIndex 查找 (O(n))",
        "磁盘 I/O 读取"
      ],
      "worst_case_complexity": "O(n_segments × n_keys) = O(n²)",
      "severity": "P1"
    }
  },

  "optimization_plan": {
    "P0_immediate_fixes": {
      "description": "立即修复，预期提升 100-200x",
      "estimated_time": "4-6 hours",
      "tasks": [
        {
          "id": "P0-1",
          "title": "SparseIndex 改用 HashMap",
          "file": "src/sparse_index.rs",
          "current": "Vec<SparseIndexEntry> - O(n) 查找",
          "target": "HashMap<String, SparseIndexEntry> - O(1) 查找",
          "expected_improvement": "100-1000x",
          "implementation": {
            "struct_change": "pub entries: HashMap<String, SparseIndexEntry>",
            "find_method": "self.entries.get(key).map(|e| e.offset)",
            "add_method": "self.entries.insert(key, entry)",
            "serialization": "需要调整 save/load 方法"
          },
          "risks": [
            "内存开销增加约 20-30%",
            "需要调整序列化/反序列化逻辑",
            "可能影响现有的 save/load 兼容性"
          ]
        },
        {
          "id": "P0-2",
          "title": "Block Cache 改用 HashMap",
          "file": "src/block_cache.rs",
          "current": "BTreeMap<String, Bytes> - O(log n) 查找",
          "target": "HashMap<String, Bytes> - O(1) 查找",
          "expected_improvement": "2-5x",
          "implementation": {
            "struct_change": "使用 HashMap 替代 BTreeMap",
            "considerations": [
              "需要保持 LRU 淘汰策略",
              "可能需要结合 HashMap + DoublyLinkedList",
              "或使用 dashmap 用于并发场景"
            ]
          },
          "risks": [
            "HashMap 不保证顺序，可能影响调试",
            "需要重新实现 LRU 逻辑"
          ]
        },
        {
          "id": "P0-3",
          "title": "Range Query 批量读取优化",
          "file": "src/lib.rs - range() 方法",
          "current": "逐个 key 独立 I/O 读取",
          "target": "按 segment 分组，批量顺序读取",
          "expected_improvement": "10-20x",
          "implementation": {
            "approach_1": "收集 range 内所有 key，按 segment 分组",
            "approach_2": "对每个 segment 执行批量读取",
            "approach_3": "启用 readahead 顺序扫描",
            "pseudocode": [
              "1. 确定涉及的 segments",
              "2. 对每个 segment:",
              "   - 收集该 segment 内的 keys",
              "   - 批量读取 (一次 I/O 或多个顺序 I/O)",
              "3. 合并所有结果并排序"
            ]
          },
          "risks": [
            "实现复杂度较高",
            "需要处理跨 segment 的 key 版本问题",
            "内存占用可能增加"
          ]
        },
        {
          "id": "P0-4",
          "title": "验证 Block Cache 预热逻辑",
          "file": "src/lib.rs, src/block_cache.rs",
          "current": "预热后 cache 命中率仍然很低",
          "target": "预热后 cache hit 率 > 95%",
          "expected_improvement": "50-100x (如果 cache 真正生效)",
          "debugging_steps": [
            "添加 cache hit/miss 统计",
            "检查 cache 容量是否足够",
            "验证 insert_by_key 是否正确执行",
            "检查 key 格式是否一致"
          ],
          "risks": [
            "可能是架构设计问题，需要更大改动",
            "Cache 策略可能不适合当前 workload"
          ]
        }
      ]
    },

    "P1_short_term_optimizations": {
